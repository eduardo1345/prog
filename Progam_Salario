#include <stdio.h>
#include <stdlib.h>

// Define o valor do salario minimo
#define SALARIO_MINIMO 1621.0

// Define o percentual de adicional das horas extras (50%)
#define PERCENTUAL_HORA_EXTRA 0.50

int main(void) {

    // Variaveis de entrada
    double quantidade_salarios_minimos, quantidade_horas_extras;

    // Variaveis utilizadas nos calculos
    double salario_base,valor_hora_normal,valor_hora_extra,salario_total;

    // Solicita a quantidade de salarios minimos recebidos
    printf("Digite quantos salarios minimos voce recebe:\n");
    scanf("%lf", &quantidade_salarios_minimos);

    // Solicita a quantidade de horas extras trabalhadas
    printf("Digite quantas horas extras voce fez:\n");
    scanf("%lf", &quantidade_horas_extras);

    // Calcula o salario normal, sem horas extras
    salario_base = quantidade_salarios_minimos * SALARIO_MINIMO;

    // Calcula o valor de uma hora normal de trabalho
    // Considerando uma jornada mensal de 176 horas
    valor_hora_normal = salario_base / 220.0;

    // Calcula o valor de uma hora extra com adicional de 50%
    valor_hora_extra = valor_hora_normal *  (1.0 + PERCENTUAL_HORA_EXTRA);

    // Soma o salario normal com o valor total das horas extras
    salario_total = salario_base + (valor_hora_extra * quantidade_horas_extras);

    // Exibe o salario final com duas casas decimais
    printf("Seu salario final e R$ %.2f\n", salario_total);

    return EXIT_SUCCESS;
}
